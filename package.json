{
  "name": "@quick-release/workbench",
  "version": "0.2.0",
  "bin": {
    "workbench": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "scripts",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "workbench.config.schema.json",
    "workbench.config.example.json"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "pnpm sync && vp dev --port 4051 --strictPort",
    "dev:demo": "WORKBENCH_DEMO_SOURCE=1 pnpm dev",
    "sync": "node scripts/sync-data.mjs && vp fmt --write src/data.generated.ts",
    "sync:demo": "WORKBENCH_DEMO_SOURCE=1 pnpm sync",
    "build": "pnpm sync && vp build",
    "preview": "vp preview",
    "test": "pnpm sync && vp test run && node --test scripts/config.test.mjs scripts/services.test.mjs scripts/source-root.test.mjs scripts/init.test.mjs scripts/sessions.test.mjs worker/worker.test.mjs",
    "lint": "vp lint .",
    "format": "vp fmt --write . && vp lint --fix .",
    "check": "pnpm sync && vp fmt --check . && vp lint . && tsc --noEmit",
    "changeset": "changeset",
    "release-publish": "changeset publish"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/router-plugin": "1.168.23",
    "@vitejs/plugin-react": "6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "3.22.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8",
    "vitest": "4.1.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "pnpm@11.24.0"
}
