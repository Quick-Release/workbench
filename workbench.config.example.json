{
  "$schema": "./workbench.config.schema.json",
  "sessions": {
    "enabled": false
  },
  "projectName": "Your project",
  "theme": {
    "background": "#14151b",
    "surface": "#191a24",
    "surfaceElevated": "#1f202a",
    "accent": "#c44900",
    "accentMuted": "#452413",
    "text": "#ffffff",
    "textMuted": "#b9b9bb",
    "textFaint": "#8a8a8d"
  },
  "services": [
    {
      "id": "asana-roadmap",
      "type": "asana",
      "label": "Asana roadmap",
      "projectGid": "replace-with-asana-project-gid",
      "tokenEnv": "ASANA_TOKEN",
      "statusMap": {
        "Ready": "ready-for-agent",
        "In progress": "in-progress",
        "Blocked": "blocked"
      }
    },
    {
      "id": "notion-tasks",
      "type": "notion",
      "label": "Notion tasks",
      "dataSourceId": "replace-with-notion-data-source-id",
      "tokenEnv": "NOTION_TOKEN",
      "properties": {
        "title": "Name",
        "status": "Status",
        "group": "Project",
        "lane": "Area",
        "id": "Ticket ID",
        "dependencies": "Dependencies",
        "summary": "Description"
      }
    },
    {
      "id": "github-issues",
      "type": "github",
      "label": "GitHub issues",
      "repo": "replace-with-owner/replace-with-repo",
      "tokenEnv": "GITHUB_TOKEN"
    },
    {
      "id": "gitlab-issues",
      "type": "gitlab",
      "label": "GitLab issues",
      "projectPath": "replace-with-group/replace-with-project",
      "tokenEnv": "GITLAB_TOKEN"
    }
  ]
}
