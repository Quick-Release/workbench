# workbench environment variables, loaded by the package scripts through
# dotenvx (https://dotenvx.com). `pnpm dev` and the other entry points copy
# this file to .env on first run; edit .env locally — it is gitignored.
# Variables already set in the shell or CI always win over file values, and
# every variable here is optional.

# --- Service tokens (scripts/services, read only while `sync` runs) ---------
# The `tokenEnv` field in workbench.config.json renames the variable a
# service expects. For GitHub, an authenticated `gh` CLI is the fallback.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# ASANA_TOKEN=
# NOTION_TOKEN=

# --- Telemetry worker (alchemy.run.ts) --------------------------------------
# Read at deploy time for the redacted TELEMETRY_INGEST_TOKEN binding.
# TELEMETRY_INGEST_TOKEN=

# --- Overrides --------------------------------------------------------------
# WORKBENCH_SOURCE_ROOT=    # read planning data from this checkout instead of the detected host
# WORKBENCH_PROJECT_NAME=
# WORKBENCH_REPOSITORY_URL=
# WORKBENCH_PORT=           # dev server port for the installed `workbench` CLI (default 4051)

# WORKBENCH_DEMO_SOURCE belongs in .env.demo, not here — see `pnpm sync:demo`.
