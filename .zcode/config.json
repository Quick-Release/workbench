{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/hooks/block-canonical-checkout.sh\"",
              "timeoutMs": 5000,
              "statusMessage": "Enforcing AGENTS.md worktree isolation"
            }
          ]
        }
      ]
    }
  }
}
