{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group Effect RC, alchemy beta, and agents 0.x pins so they move together",
      "matchPackagePatterns": ["^effect$", "^@effect/", "^alchemy$", "^agents$"],
      "groupName": "effect-and-alchemy"
    }
  ]
}
