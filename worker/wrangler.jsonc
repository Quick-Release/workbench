{
  // Deploy from this directory: npx wrangler deploy
  // The D1 database_id is filled in at deploy time (worker/README.md).
  "name": "workbench-telemetry",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  // Required by the Agents SDK (agents, ticket #31).
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "workbench-telemetry",
      "database_id": "REPLACE_AFTER_D1_CREATE",
    },
  ],
  // Session capture (ticket #35): create the bucket by hand on this path
  // (npx wrangler r2 bucket create workbench-llm-captures) — the same
  // escape-hatch pattern as the D1 database_id above. The provider origin
  // and key are plain-text and secret bindings respectively; set them
  // with `npx wrangler secret put LLM_PROVIDER_KEY` (and
  // `vars`/`--var` for LLM_PROVIDER_ORIGIN when overriding the default).
  "r2_buckets": [
    {
      "binding": "LLM_CAPTURES",
      "bucket_name": "workbench-llm-captures",
    },
  ],
  "vars": {
    "LLM_PROVIDER_ORIGIN": "https://api.anthropic.com",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SubmissionReviewAgent",
        "class_name": "SubmissionReviewAgent",
      },
    ],
  },
  // SQLite-backed storage for the agent class (the SDK's state tables use
  // the Durable Object SQL API). Alchemy derives this migration itself on
  // the alchemy.run.ts path; it is spelled out here so the escape hatch
  // stays deployable (ADR 0003).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SubmissionReviewAgent"] }],
}
